# --- LLM provider ---
# "openai" (any OpenAI-compatible API) or "gemini" (Google AI Studio).
LLM_PROVIDER=gemini

# --- Google Gemini (used when LLM_PROVIDER=gemini) ---
# Get a key at https://aistudio.google.com/apikey
# NOTE: gemini-1.5-flash was retired by Google and now returns 404;
# gemini-flash-latest always tracks the current flash model.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-flash-lite-latest

# --- OpenAI-compatible (used when LLM_PROVIDER=openai) ---
# Required: the API key used to call the LLM.
OPENAI_API_KEY=sk-your-key-here
# Base URL of the OpenAI-compatible endpoint (OpenAI, Groq, Ollama, vLLM, OpenRouter, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
# Model name for the OpenAI-compatible provider.
LLM_MODEL=gpt-4o-mini

# --- Shared LLM behaviour ---
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000
# Request timeout in seconds and automatic retries for transient errors / rate limits.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Ask the API for native JSON mode. Set to false for providers that reject it.
LLM_JSON_MODE=true

# --- PRISM tracing (live observability) ---
# Sends every chat turn (prompt, answer, latency, confidence) to a PRISM dashboard.
# Get credentials from your PRISM project settings; the API key is secret.
PRISMTRACE_API_KEY=your-prism-key-here
PRISMTRACE_PROJECT_ID=your-prism-project-id
PRISMTRACE_HOST=https://prism-api-prod.up.railway.app

# --- Chat behaviour ---
# How many previous exchanges of the same conversation are replayed to the model.
MAX_HISTORY_TURNS=10
# Confidence below this value counts as "low confidence" (stats + self-improvement).
LOW_CONFIDENCE_THRESHOLD=0.7
# Max low-confidence rows the /improve endpoint looks at.
IMPROVE_SAMPLE_LIMIT=200

# --- Storage ---
# SQLite (default). For PostgreSQL use e.g.
#   postgresql+asyncpg://user:password@localhost:5432/confidence_forge
# (requires: pip install asyncpg)
DATABASE_URL=sqlite+aiosqlite:///./confidence_forge.db

# --- HTTP ---
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Repeat-question answer cache (single-digit-ms responses for identical asks)
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_SIZE=1024
ANSWER_CACHE_TTL_SECONDS=3600
# Pre-warm the answer cache with common questions at startup
PREWARM_ENABLED=true
